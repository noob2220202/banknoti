<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NotifyBridge"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#1A1A1A"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="라이선스 인증이 필요합니다"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginBottom="32dp" />

        <!-- 현재 라이선스 상태 -->
        <TextView
            android:id="@+id/licenseStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="라이선스 확인 중..."
            android:textSize="15sp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.5"
            android:padding="16dp"
            android:background="#FFFFFF"
            android:elevation="2dp"
            android:layout_marginBottom="32dp" />

        <!-- 키 입력 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="라이선스 키 입력"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/inputLicenseKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="1234567890-ABCDEF123456"
            android:inputType="textVisiblePassword"
            android:fontFamily="monospace"
            android:textSize="14sp"
            android:padding="14dp"
            android:background="#FFFFFF"
            android:layout_marginBottom="12dp" />

        <!-- 활성화 버튼 -->
        <Button
            android:id="@+id/btnActivate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="라이선스 활성화"
            android:textSize="15sp"
            android:padding="14dp"
            android:backgroundTint="#FFCD00"
            android:textColor="#1A1A1A"
            android:layout_marginBottom="12dp" />

        <!-- 계속하기 버튼 -->
        <Button
            android:id="@+id/btnContinue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="앱 시작하기 →"
            android:textSize="15sp"
            android:padding="14dp"
            android:backgroundTint="#1A1A1A"
            android:textColor="#FFFFFF"
            android:enabled="false"
            android:alpha="0.4" />

    </LinearLayout>
</ScrollView>
