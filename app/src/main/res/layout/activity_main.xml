<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="#FAFAFA">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NotifyBridge"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#1A1A1A"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="카카오뱅크 → 텔레그램 알림 전송"
        android:textSize="14sp"
        android:textColor="#666666"
        android:layout_marginBottom="40dp" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="상태 확인 중..."
        android:textSize="15sp"
        android:textColor="#333333"
        android:gravity="start"
        android:lineSpacingMultiplier="1.6"
        android:layout_marginBottom="32dp"
        android:padding="16dp"
        android:background="#FFFFFF"
        android:elevation="2dp" />

    <Button
        android:id="@+id/permButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="권한 허용하러 가기"
        android:textSize="15sp"
        android:padding="14dp"
        android:backgroundTint="#FFCD00"
        android:textColor="#1A1A1A"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/settingsButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="텔레그램 봇 설정"
        android:textSize="15sp"
        android:padding="14dp"
        android:backgroundTint="#2CA5E0"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/licenseButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🔑 라이선스 관리"
        android:textSize="15sp"
        android:padding="14dp"
        android:backgroundTint="#555555"
        android:textColor="#FFFFFF" />

</LinearLayout>
